# Supabase 环境变量（遥测与匿名身份）
#
# 复制本文件为 app/.env.local 并填入你的项目值。
# 缺失这两项时游戏照常可玩，仅遥测/身份/云端排行榜处于关闭状态。
#
# 项目 ref: weuwdzrgfoeomcauwgmv
# 项目 URL: https://weuwdzrgfoeomcauwgmv.supabase.co
#
# 安全：这里只放 anon / publishable key（发布用途）。
# service_role / secret key 严禁进入客户端代码或任何提交到仓库的文件。

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# 服务端已部署并可重放校验的规则版本；V4 后端上线前保持 3。
VITE_VERIFIED_RULES_VERSIONS=3
